+++ b/scripts/posing-cleanup-database.mjs
@@ -0,0 +1,52 @@
+// Disposable local PostgreSQL test; no provider calls or production access.
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import { execFileSync } from 'node:child_process';
+const container='elevare-runtime-test-db', database=`posing_cleanup_${Date.now()}`;
+const docker=args=>execFileSync('docker',args,{encoding:'utf8',windowsHide:true,stdio:'pipe'});
+assert.equal(docker(['inspect','--format','{{.Config.Image}}',container]).trim(),'public.ecr.aws/supabase/postgres:17.6.1.127');
+const sql=s=>docker(['exec',container,'psql','-U','supabase_admin','-d',database,'-v','ON_ERROR_STOP=1','-At','-c',s]).trim();
+docker(['exec',container,'psql','-U','supabase_admin','-d','postgres','-v','ON_ERROR_STOP=1','-c',`create database ${database}`]);
+try {
+ const user=crypto.randomUUID();
+ sql(`create schema storage;
+ create table storage.objects(bucket_id text,name text,created_at timestamptz);
+ create table public.elevare_posing_upload_sessions(status text,expires_at timestamptz,updated_at timestamptz,object_paths jsonb);
+ create table public.posing_analyses(status text,updated_at timestamptz,user_id uuid,client_request_id text);
+ insert into storage.objects values
+ ('posing-analysis-temp','web/active/video.mp4',now()-interval '121 minutes'),
+ ('posing-analysis-temp','web/active/frame.jpg',now()-interval '121 minutes'),
+ ('posing-analysis-temp','web/stuck/video.mp4',now()-interval '5 hours'),
+ ('posing-analysis-temp','web/abandoned/video.mp4',now()-interval '3 hours'),
+ ('posing-analysis-temp','web/initializing/video.mp4',now()-interval '121 minutes'),
+ ('posing-analysis-temp','web/failed/video.mp4',now()-interval '3 hours'),
+ ('posing-analysis-temp','orphan/frame.jpg',now()-interval '3 hours'),
+ ('posing-analysis-temp','recent/frame.jpg',now()-interval '1 minute'),
+ ('posing-analysis-temp','${user}/mobile-request/frames/1.jpg',now()-interval '121 minutes'),
+ ('other-private-bucket','orphan/frame.jpg',now()-interval '3 hours');
+ insert into public.elevare_posing_upload_sessions values
+ ('analyzing',now()-interval '1 minute',now()-interval '1 minute','{"video_path":"web/active/video.mp4","frames":[{"path":"web/active/frame.jpg"}]}'),
+ ('analyzing',now()-interval '3 hours',now()-interval '3 hours','{"video_path":"web/stuck/video.mp4"}'),
+ ('initialized',now()-interval '1 hour',now()-interval '3 hours','{"video_path":"web/abandoned/video.mp4"}'),
+ ('initialized',now()+interval '1 minute',now()-interval '121 minutes','{"video_path":"web/initializing/video.mp4"}'),
+ ('failed',now()-interval '1 hour',now(),' {"video_path":"web/failed/video.mp4"}');
+ insert into public.posing_analyses values('analyzing',now(),'${user}','mobile-request');`);
+ const migration=fs.readFileSync(new URL('../supabase/migrations/202609141300_protect_active_posing_cleanup.sql',import.meta.url),'utf8');
+ sql(migration);sql(migration);
+ const list=()=>sql("select object_name from public.list_stale_posing_analysis_temp_objects(now()-interval '2 hours',1000)").split('\n').sort();
+ assert.deepEqual(list(),['orphan/frame.jpg','web/abandoned/video.mp4','web/failed/video.mp4','web/stuck/video.mp4'].sort());
+ console.log('PASS stale orphan/failed/abandoned/stuck media eligible; near-expiry reservation, frames, mobile job, valid upload and unrelated bucket protected');
+ sql("update public.elevare_posing_upload_sessions set status='complete' where object_paths->>'video_path'='web/active/video.mp4'");
+ assert.ok(list().includes('web/active/video.mp4')); assert.ok(list().includes('web/active/frame.jpg'));
+ console.log('PASS media becomes eligible after terminal completion, including retry after failed removal');
+ // Same conditional predicates used by the Edge Function, including a second
+ // check at mutation time. A completion between lookup and update is retained.
+ sql("create temporary table candidates as select object_paths from public.elevare_posing_upload_sessions where status in ('initialized','analyzing') and expires_at<now() and updated_at<now()-interval '2 hours'; update public.elevare_posing_upload_sessions set status='complete',updated_at=now() where object_paths->>'video_path'='web/stuck/video.mp4'; update public.elevare_posing_upload_sessions s set status='expired' where object_paths in(select object_paths from candidates) and status in ('initialized','analyzing') and expires_at<now() and updated_at<now()-interval '2 hours'");
+ assert.equal(sql("select status from public.elevare_posing_upload_sessions where object_paths->>'video_path'='web/stuck/video.mp4'"),'complete');
+ console.log('PASS completed job is not overwritten by stale lookup; recent reservations do not expire');
+ for(const role of ['anon','authenticated'])assert.equal(sql(`select has_function_privilege('${role}','public.list_stale_posing_analysis_temp_objects(timestamptz,integer)','execute')`),'f');
+ assert.equal(sql("select count(*) from public.list_stale_posing_analysis_temp_objects(now()-interval '2 hours',1)"),'1');
+ console.log('PASS cleanup inventory service-only and bounded');
+} finally {
+ docker(['exec',container,'psql','-U','supabase_admin','-d','postgres','-v','ON_ERROR_STOP=1','-c',`drop database ${database}`]);
+}
