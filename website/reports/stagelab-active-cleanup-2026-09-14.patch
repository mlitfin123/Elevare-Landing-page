diff --git a/supabase/migrations/202609141300_protect_active_posing_cleanup.sql b/supabase/migrations/202609141300_protect_active_posing_cleanup.sql
new file mode 100644
--- /dev/null
+++ b/supabase/migrations/202609141300_protect_active_posing_cleanup.sql
@@ -0,0 +1,30 @@
+-- StageLab project, not Elevare-Prod. Preserve jobs reserved near upload expiry.
+begin;
+create or replace function public.list_stale_posing_analysis_temp_objects(
+  p_cutoff timestamptz, p_limit integer default 1000
+)
+returns table(object_name text) language sql stable security definer
+set search_path = pg_catalog, public, storage as $$
+  select object.name from storage.objects object
+  where object.bucket_id = 'posing-analysis-temp' and object.created_at < p_cutoff
+    and not exists (
+      select 1 from public.elevare_posing_upload_sessions session
+      where session.status in ('initialized','analyzing')
+        and (session.expires_at > now() or session.updated_at >= p_cutoff)
+        and (session.object_paths->>'video_path' = object.name
+          or coalesce(session.object_paths->'frames','[]'::jsonb) @> jsonb_build_array(jsonb_build_object('path',object.name)))
+    )
+    and not exists (
+      select 1 from public.posing_analyses analysis
+      where analysis.status in ('uploaded','validating','analyzing','cleanup_pending')
+        and analysis.updated_at >= p_cutoff
+        and analysis.user_id is not null and analysis.client_request_id is not null
+        and starts_with(object.name, analysis.user_id::text || '/' || analysis.client_request_id || '/')
+    )
+  order by object.created_at asc
+  limit least(greatest(coalesce(p_limit,1000),1),1000);
+$$;
+revoke all on function public.list_stale_posing_analysis_temp_objects(timestamptz,integer) from public, anon, authenticated;
+grant execute on function public.list_stale_posing_analysis_temp_objects(timestamptz,integer) to service_role;
+notify pgrst, 'reload schema';
+commit;
