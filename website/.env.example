SUPABASE_URL=https://yozfzsudbcqjttepjnyg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://yozfzsudbcqjttepjnyg.supabase.co

SECOND_SUPABASE_URL=https://your-second-project-id.supabase.co
SECOND_SUPABASE_SERVICE_ROLE_KEY=your-second-supabase-service-role-key
PROFESSIONAL_REVALIDATION_SECRET=
# Use at least 32 random characters. Server-only; never prefix this with NEXT_PUBLIC_.
# SECOND_SUPABASE_URL and NEXT_PUBLIC_SECOND_SUPABASE_URL must identify the same project.
# For the optional Supabase delivery function, configure PROFESSIONAL_REVALIDATION_ORIGIN
# as https://www.elevarefit.com in its server-side secrets, together with the same secret.
NEXT_PUBLIC_SECOND_SUPABASE_URL=https://your-second-project-id.supabase.co
NEXT_PUBLIC_SECOND_SUPABASE_ANON_KEY=your-second-supabase-anon-key

# Localization rollout (keep both false until translated routes pass human review)
NEXT_PUBLIC_ENABLE_LOCALIZED_ROUTES=false
ENABLE_LOCALIZED_INDEXING=false

# Quick Analysis narrative rollout (server-only; interface localization uses the route flag above)
ENABLE_QUICK_ANALYSIS_ES_419_GENERATION=false
ENABLE_QUICK_ANALYSIS_PT_BR_GENERATION=false

# StageLab Quick Analysis (server-only unless explicitly marked public)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_QUICK_ANALYSIS_PRICE_ID=
STRIPE_PRICE_POSING_ANALYSIS=
STRIPE_PRICE_COMPLETE_STAGE_ANALYSIS=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
OPENAI_API_KEY=
OPENAI_QUICK_ANALYSIS_MODEL=
QUICK_ANALYSIS_TOKEN_PEPPER=
CRON_SECRET=

# Posing generation is independent of Quick Analysis flags. Omitted values default true.
# Explicit false disables checkout in that language; it never silently generates English.
ENABLE_POSING_ANALYSIS_ES_419_GENERATION=true
ENABLE_POSING_ANALYSIS_PT_BR_GENERATION=true

# StageLab posing gateway (server-only; never use NEXT_PUBLIC_ prefixes)
# Verify this is the intended deployed StageLab project; see reports/posing-hardening-2026-09-12.md.
STAGELAB_POSING_BASE_URL=https://stagelab.supabase.co/functions/v1
STAGELAB_ELEVARE_KEY_ID=elevare-production-v1
STAGELAB_ELEVARE_INTEGRATION_SECRET=

# Supabase Edge Function secrets for professional approval email delivery
# Configure these in the Elevare-Prod Supabase project, not as NEXT_PUBLIC values.
RESEND_API_KEY=
RESEND_TRANSACTIONAL_FROM=Elevare Professionals <noreply@elevarefit.org>
RESEND_TRANSACTIONAL_REPLY_TO=mlitfin@elevarefit.org
# Matching notifications and admin alerts: Supabase Edge Function secrets only.
# Enable after applying the notification migration and deploying its worker.
MARKETPLACE_EMAIL_DELIVERY_ENABLED=false
MARKETPLACE_ADMIN_ALERT_EMAIL=mlitfin@elevarefit.org
# Optional HTTPS link to the separate admin app; alerts work without it.
MARKETPLACE_ADMIN_URL=
